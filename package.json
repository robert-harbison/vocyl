{
	"name": "vocyl",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"package:windows": "tauri build --bundles nsis,msi",
		"package:linux": "tauri build --bundles appimage,deb,rpm",
		"package:mac": "tauri build --bundles dmg,app",
		"package:mac:intel": "tauri build --target x86_64-apple-darwin --bundles dmg,app",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"coverage": "vitest run --coverage",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,css,json,md}": "prettier --write"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"clsx": "^2.1.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.75.0",
		"tailwindcss": "^4.3.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@eslint/js": "^10.0.1",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.7.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.6",
		"@vitest/ui": "^4.1.6",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.4",
		"prettier": "^3.8.3",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.59.3",
		"vite": "^8.0.12",
		"vitest": "^4.1.6"
	}
}
